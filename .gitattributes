# Normalise to LF in the repository. Without this, files authored on Windows
# are committed with CRLF and any script that reaches a Linux CI runner fails
# with `bad interpreter: /bin/bash^M`.
* text=auto eol=lf

# Windows-only files that must keep CRLF on checkout.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary.
*.png binary
*.ico binary
*.icns binary
*.jpg binary
*.webp binary
*.woff binary
*.woff2 binary
*.exe binary
*.dll binary

# Generated — collapse in diffs and exclude from language stats.
pnpm-lock.yaml linguist-generated=true -diff
Cargo.lock linguist-generated=true -diff
packages/protocol/src/generated/** linguist-generated=true -diff
