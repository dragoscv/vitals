    "local_network_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone asks once whether Vitals may reach devices on your network. Without it, Vitals cannot see your PCs. You can change it in Settings, Vitals, Local Network."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone-ul întreabă o dată dacă Vitals poate accesa dispozitive din rețea. Fără acest acord, Vitals nu vede PC-urile tale. Poți schimba asta în Setări, Vitals, Rețea locală."
          }
        }
      }
    },
