    },
    "settings_access_usage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage access"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acces la utilizare"
          }
        }
      }
    },
    "settings_access_usage_disclosure": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets Vitals read screen time, launches, data and storage per app from Android’s usage statistics. Read on this phone only, never sent anywhere."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Îi permite lui Vitals să citească timpul pe ecran, deschiderile, datele și spațiul fiecărei aplicații din statisticile de utilizare Android. Citite doar pe acest telefon, nu sunt trimise nicăieri."
          }
        }
      }
    },
    "settings_can_control": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can change programs"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poate schimba programe"
          }
        }
      }
    },
    "settings_device_history": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record history"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrează istoricul"
          }
        }
      }
    },
    "settings_device_history_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A reading every 15 minutes, kept for a week, plus alerts when the phone overheats or runs low. Uses almost no battery."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O citire la 15 minute, păstrată o săptămână, plus alerte când telefonul se încinge sau rămâne fără baterie. Consumă aproape deloc."
          }
        }
      }
    },
    "settings_glass": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frosted glass"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sticlă mată"
          }
        }
      }
    },
    "settings_glass_auto": {
      "extractionState": "manual",
      "localizations": {
