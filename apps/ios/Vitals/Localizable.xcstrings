    "settings_about": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Despre"
          }
        }
      }
    },
    "settings_about_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitals measures this phone and, if you pair one, a Windows PC on your home network. No ads, no account, no analytics of our own: nothing is sent to the developer."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitals măsoară acest telefon și, dacă asociezi unul, un PC cu Windows din rețeaua de acasă. Fără reclame, fără cont, fără analiză proprie: dezvoltatorul nu primește nimic."
          }
        }
      }
    },
    "settings_about_body_ios": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitals shows the readings of PCs you pair on your home network. No ads, no account, no analytics: nothing is sent to the developer, and nothing leaves your network."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitals arată citirile PC-urilor pe care le asociezi în rețeaua de acasă. Fără reclame, fără cont, fără analiză: dezvoltatorul nu primește nimic și nimic nu iese din rețeaua ta."
          }
        }
      }
    },
    "settings_access_files": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All-files access"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acces la toate fișierele"
          }
        }
      }
    },
    "settings_access_off": {
      "extractionState": "manual",
