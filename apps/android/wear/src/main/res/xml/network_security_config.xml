<?xml version="1.0" encoding="utf-8"?>
<!--
    The LAN API is plain HTTP by design (ADR-0003). This config cannot name
    IP ranges, so cleartext is allowed here and LanAddress.isPrivate refuses
    any non-private address before a request is made.
-->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
