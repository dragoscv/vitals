<?xml version="1.0" encoding="utf-8"?>
<!-- The APK published on GitHub (and Obtainium/F-Droid style installs) keeps
     the full folder scan and file cleanup. The `play` flavour leaves these out:
     Google rejected all-files access for a system monitor on 2026-10-14. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
</manifest>
