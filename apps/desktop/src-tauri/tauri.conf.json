{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vitals",
  "version": "0.9.0-beta.1",
  "identifier": "app.vitals.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:vite",
    "devUrl": "http://localhost:5273",
    "beforeBuildCommand": "pnpm build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Vitals",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "decorations": false,
        "transparent": false,
        "dragDropEnabled": false,
        "visible": false,
        "theme": null
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "publisher": "Dragos Catalin Vladulescu",
    "copyright": "MIT © 2026 Dragos Catalin Vladulescu and Vitals contributors",
    "homepage": "https://vitals.dragoscatalin.ro",
    "license": "MIT",
    "licenseFile": "../../../LICENSE",
    "category": "Utility",
    "shortDescription": "A modern, fast system monitor and task manager.",
    "longDescription": "Vitals is a fast, native system monitor and task manager: a configurable dashboard, deep performance telemetry, full process control, network and storage management, and benchmarks. Free and open source, forever.",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": false,
        "languages": ["English", "Romanian"],
        "compression": "lzma",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": ["https://github.com/dragoscv/vitals/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQwQjFDQTc1NENGMjdCMEMKUldRTWUvSk1kY3F4MERLMG5qdnFTelFVVDhKUzM4Wm5SbzF4cXJlb2JPai90eFdaUitoY3FBd3EK",
      "windows": { "installMode": "passive" }
    }
  }
}
