# Staged by scripts/bundle-sensors.ps1 (beforeBuildCommand). .gitkeep keeps the
# resource directory present so tauri-build accepts it in a clean checkout.
sensors/*
!sensors/.gitkeep
# Staged by scripts/bundle-watchdog.ps1, same reason.
watchdog/*
!watchdog/.gitkeep
# Mac App Store build inputs written by scripts/macos/build-appstore.sh: the
# profile is per-team and expires; the entitlements carry the team id.
macos/embedded.provisionprofile
macos/Entitlements.appstore.resolved.plist
