# Dependencies
node_modules/
.pnpm-store/
# The real cache directory on this setup is `.pnpm-cache`, not `.pnpm-store`.
# Missing it meant 214 MB of registry metadata — 399 files — was committed,
# and every clone paid for it.
.pnpm-cache/

# Build output
dist/
build/
out/
target/
*.tsbuildinfo

# Turborepo
.turbo/

# Generated protocol bindings (regenerated from Rust on build)
packages/protocol/src/generated/

# Env
.env
.env.*
!.env.example

# Editor / OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
.DS_Store
Thumbs.db

# Test / coverage
coverage/
.vitest/
test-results/

# Agent scratch (globally gitignored convention)
.copilot-tmp/

# Tauri
apps/desktop/src-tauri/gen/
apps/desktop/src-tauri/target/

# Signing keys — never commit
*.pem
*.key
!**/tauri-updater.pub

# Vitest 5 writes reporter output here
.vitest/
